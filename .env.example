# --- MySQL ---
# With Docker this is set to "db" automatically, leave it as it is.
MYSQL_HOST=localhost
MYSQL_USER=root
# Without Docker you may leave the password empty to be asked every time (hidden typing).
# With Docker it is REQUIRED: the database container uses it as its root password.
# Tip: use letters and digits only (no $ or quotes), Docker reads this file too.
MYSQL_PASSWORD=

# --- Sign-up access codes (one per role, keep them all DIFFERENT) ---
# Whoever knows a code can register ONLY with that role.
# Roles with no code here cannot be registered.
ADMIN_ACCESS_CODE=change-me-admin
HR_ACCESS_CODE=change-me-hr
IT_ACCESS_CODE=change-me-it
MYSQL_DATABASE=MNC
# --- API login tokens ---
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
